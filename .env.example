# Stage 2 real mode. Copy to .env for Compose; local Java needs shell env vars.
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

# Stage 2 database placeholders
POSTGRES_DB=code_atlas
DB_URL=jdbc:postgresql://localhost:5432/code_atlas
DB_USER=code_atlas
DB_PASSWORD=change-me

# Stage 3 model placeholders - keep real keys outside source control
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REVISION=1
# USD per million tokens; blank = unknown
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=
EMBEDDING_INPUT_PRICE=
